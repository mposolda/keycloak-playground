<mxfile host="app.diagrams.net" modified="2024-01-01T00:00:00.000Z" agent="Bob" version="21.0.0" type="device">
  <diagram id="part2-jwt-proof" name="Part 2 – JWT Proof">
    <mxGraphModel dx="1422" dy="762" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ══════════════════════════════════════════
             PARTY BOXES  (SVG coords × 2)
             Wallet  : x=25→50,   y=20→40, w=150→300, h=60→120
             Issuer  : x=305→610, y=20→40, w=150→300, h=60→120
             Verifier: x=585→1170,y=20→40, w=150→300, h=60→120
             Centres: Wallet=200, Issuer=760, Verifier=1320
        ════════════════════════════════════════════ -->

        <!-- Wallet box -->
        <mxCell id="wallet" value="&lt;b&gt;Wallet&lt;/b&gt;&lt;br&gt;generates proof key&lt;br&gt;signs proof JWT"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;arcSize=5;fontSize=15;"
                vertex="1" parent="1">
          <mxGeometry x="50" y="40" width="300" height="120" as="geometry"/>
        </mxCell>

        <!-- Issuer box -->
        <mxCell id="issuer" value="&lt;b&gt;Issuer&lt;/b&gt;&lt;br&gt;(Keycloak)&lt;br&gt;verifies proof → cnf"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;arcSize=5;fontSize=15;"
                vertex="1" parent="1">
          <mxGeometry x="610" y="40" width="300" height="120" as="geometry"/>
        </mxCell>

        <!-- Verifier box -->
        <mxCell id="verifier" value="&lt;b&gt;Verifier&lt;/b&gt;&lt;br&gt;verifies issuer sig&lt;br&gt;+ key binding (cnf)"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;arcSize=5;fontSize=15;"
                vertex="1" parent="1">
          <mxGeometry x="1170" y="40" width="300" height="120" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════════════
             LIFELINES  (dashed vertical lines)
             SVG y1=80→160, y2=290→580
        ════════════════════════════════════════════ -->

        <!-- Wallet lifeline -->
        <mxCell id="lifeline-wallet" value=""
                style="endArrow=none;dashed=1;dashPattern=8 8;strokeColor=#666666;strokeWidth=1.5;"
                edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="160" as="sourcePoint"/>
            <mxPoint x="200" y="580" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Issuer lifeline -->
        <mxCell id="lifeline-issuer" value=""
                style="endArrow=none;dashed=1;dashPattern=8 8;strokeColor=#666666;strokeWidth=1.5;"
                edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="160" as="sourcePoint"/>
            <mxPoint x="760" y="580" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Verifier lifeline -->
        <mxCell id="lifeline-verifier" value=""
                style="endArrow=none;dashed=1;dashPattern=8 8;strokeColor=#666666;strokeWidth=1.5;"
                edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1320" y="160" as="sourcePoint"/>
            <mxPoint x="1320" y="580" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ══════════════════════════════════════════
             MESSAGES  (SVG y × 2)
             ① y=106→212  dashed
             ② y=146→292
             ③ y=192→384
             ④ y=238→476
        ════════════════════════════════════════════ -->

        <!-- Message ①: Wallet → Issuer  (Get c_nonce) — dashed arrow -->
        <mxCell id="msg1" value="① Get c_nonce (Nonce endpoint)"
                style="endArrow=open;endSize=8;dashed=1;dashPattern=8 4;strokeColor=#000000;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=bottom;labelBackgroundColor=none;"
                edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="212" as="sourcePoint"/>
            <mxPoint x="760" y="212" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Message ②: Wallet → Issuer  (Credential Request) -->
        <mxCell id="msg2" value="② Credential Request (proofs.jwt)&#xa;proof JWT signed by proof key (header: jwk)"
                style="endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=bottom;labelBackgroundColor=none;"
                edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="292" as="sourcePoint"/>
            <mxPoint x="760" y="292" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Message ③: Issuer → Wallet  (SD-JWT VC) -->
        <mxCell id="msg3" value="③ SD-JWT VC&#xa;(cnf claim contains proof public key)"
                style="endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=bottom;labelBackgroundColor=none;"
                edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="384" as="sourcePoint"/>
            <mxPoint x="200" y="384" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Message ④: Wallet → Verifier  (SD-JWT Presentation + Key-Binding JWT) -->
        <mxCell id="msg4" value="④ SD-JWT Presentation + Key-Binding JWT&#xa;&lt;issuer-jwt&gt; ~ &lt;disclosures&gt; ~ &lt;key-binding-jwt&gt;"
                style="endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=bottom;labelBackgroundColor=none;html=1;"
                edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="476" as="sourcePoint"/>
            <mxPoint x="1320" y="476" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ══════════════════════════════════════════
             NOTE BOX under Verifier
             SVG: x=535→1070, y=266→532, w=235→470, h=52→104
        ════════════════════════════════════════════ -->

        <mxCell id="note" value="⑤ Issuer signature verified ✓&#xa;Holder Key Binding verified (cnf) ✓&#xa;(nonce, aud, sd_hash verified)"
                style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8f8f8;strokeColor=#000000;strokeWidth=1;fontSize=15;fontColor=#000000;arcSize=3;"
                vertex="1" parent="1">
          <mxGeometry x="1070" y="520" width="500" height="110" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
